    <div *ngIf="scannedItems.length > 0; else noActiveTpl" class="active-basket-container">
      <ng-container *ngIf="scannedItems[0] as activeItem">

        <!-- BEAUTIFUL OVERLAY -->
        <div class="beautiful-loading-overlay" *ngIf="activeItem.isLoading && activeItem.status !== 'FAILED'">
           <div class="modern-spinner"></div>
           <div class="loading-title">\u0E01\u0E33\u0E25\u0E31\u0E07\u0E14\u0E36\u0E07\u0E02\u0E49\u0E2D\u0E21\u0E39\u0E25\u0E15\u0E30\u0E01\u0E23\u0E49\u0E32</div>
           <div class="loading-subtitle">
             \u0E23\u0E2D\u0E2A\u0E31\u0E01\u0E04\u0E23\u0E39\u0E48 \u0E23\u0E30\u0E1A\u0E1A\u0E01\u0E33\u0E25\u0E31\u0E07\u0E04\u0E49\u0E19\u0E2B\u0E32\u0E23\u0E32\u0E22\u0E01\u0E32\u0E23\u0E22\u0E32<span class="typing-dots"></span>
           </div>
        </div>

        <!-- Left: Patient Details -->
        <div class="patient-details" style="padding: 0;">
          <h2 class="panel-title" style="margin-bottom: 20px; display: flex; align-items: center; justify-content: space-between;">
            <span>\u0E15\u0E30\u0E01\u0E23\u0E49\u0E32\u0E17\u0E35\u0E48\u0E01\u0E33\u0E25\u0E31\u0E07\u0E14\u0E33\u0E40\u0E19\u0E34\u0E19\u0E01\u0E32\u0E23</span>
            <span class="status-badge" *ngIf="activeItem.status !== 'FAILED' && activeItem.status !== 'SUCCESS'" style="display: flex; align-items: center; gap: 8px; font-size: 0.85rem; padding: 4px 12px; border-radius: 20px; background: #e0f2fe; color: #0369a1; border: 1px solid #bae6fd;">
               <div class="spinner-small" style="width: 14px; height: 14px; border: 2px solid #0369a1; border-top-color: transparent; border-radius: 50%; animation: spin 1s linear infinite;"></div>
               <ng-container *ngIf="activeItem.status === 'PENDING'">\u0E14\u0E36\u0E07\u0E02\u0E49\u0E2D\u0E21\u0E39\u0E25...</ng-container>
               <ng-container *ngIf="activeItem.status === 'CHECKING_STOCK'">\u0E40\u0E0A\u0E47\u0E04\u0E2A\u0E15\u0E47\u0E2D\u0E01...</ng-container>
               <ng-container *ngIf="activeItem.status === 'DISPENSING'">\u0E2A\u0E48\u0E07\u0E04\u0E33\u0E2A\u0E31\u0E48\u0E07...</ng-container>
               <ng-container *ngIf="activeItem.status === 'WAITING_DRUGS'">\u0E01\u0E33\u0E25\u0E31\u0E07\u0E08\u0E48\u0E32\u0E22\u0E22\u0E32...</ng-container>
            </span>
          </h2>
          <div class="patient-header-clean">
            <h3>{{ activeItem.patientInfo?.patientname || activeItem.patientInfo?.name || '\u0E44\u0E21\u0E48\u0E23\u0E30\u0E1A\u0E38\u0E0A\u0E37\u0E48\u0E2D' }}</h3>
            <div style="display: flex; gap: 10px; flex-wrap: wrap;">
              <span class="badge vn-badge">VN: {{ activeItem.patientInfo?.vn || activeItem.patientInfo?.an }}</span>
              <span class="badge hn-badge">HN: {{ activeItem.patientInfo?.hn }}</span>
            </div>
          </div>
          
          <div class="basket-id" style="background: transparent; border: 1px solid var(--border-color);">
            <span class="label">\u0E2B\u0E21\u0E32\u0E22\u0E40\u0E25\u0E02\u0E15\u0E30\u0E01\u0E23\u0E49\u0E32</span>
            <span class="value" style="color: var(--primary-color); font-size: 2rem;">{{ activeItem.patientInfo?.basketno || '-' }}</span>
            <span class="label" style="margin-top: 10px; font-size: 0.8rem;">RFID: {{ activeItem.id }}</span>
          </div>

          <!-- Status Indicator -->
          <div style="margin-top: 16px;">
              <div *ngIf="activeItem.status === 'FAILED'" class="error-state" style="padding: 15px;">
                <div class="icon" style="font-size: 2rem; margin-bottom: 5px;">\u26A0\uFE0F</div>
                <h3 style="font-size: 1rem;">\u0E40\u0E01\u0E34\u0E14\u0E02\u0E49\u0E2D\u0E1C\u0E34\u0E14\u0E1E\u0E25\u0E32\u0E14</h3>
                <p style="font-size: 0.9rem;">{{ activeItem.errorMsg }}</p>
              </div>
          </div>
        </div>

        <!-- Right: Drug Table (Auto Height) -->
        <div class="drugs-panel">
          <h2 class="panel-title" style="margin-bottom: 20px;">\u0E23\u0E32\u0E22\u0E01\u0E32\u0E23\u0E22\u0E32\u0E2A\u0E33\u0E2B\u0E23\u0E31\u0E1A\u0E40\u0E04\u0E23\u0E37\u0E48\u0E2D\u0E07 SEMED</h2>
          <div class="glass-panel auto-height">
            <ng-container *ngIf="activeItem.patientInfo || activeItem.status === 'FAILED'; else loadingDrugs">
              <div class="table-container" style="border-radius: 12px; overflow-y: auto; max-height: 400px;">
                <table class="tech-table">
                  <thead>
                    <tr>
                      <th>\u0E25\u0E33\u0E14\u0E31\u0E1A</th>
                      <th>\u0E23\u0E2B\u0E31\u0E2A\u0E22\u0E32</th>
                      <th>\u0E0A\u0E37\u0E48\u0E2D\u0E22\u0E32</th>
                      <th>\u0E08\u0E33\u0E19\u0E27\u0E19</th>
                      <th>\u0E2B\u0E19\u0E48\u0E27\u0E22</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr *ngFor="let drug of activeItem.drugsList; let j = index">
                      <td>{{ j + 1 }}</td>
                      <td>{{ drug.orderitemcode || drug.icode }}</td>
                      <td class="drug-name">{{ drug.orderitemname || drug.drugname || drug.name }}</td>
                      <td><span class="qty-highlight">{{ drug.orderqty || drug.qty }}</span></td>
                      <td class="unit">{{ drug.instruction || drug.orderunitdesc || drug.shortlist }}</td>
                    </tr>
                    <tr *ngIf="!activeItem.drugsList || activeItem.drugsList.length === 0">
                      <td colspan="5" class="empty-row">\u0E44\u0E21\u0E48\u0E21\u0E35\u0E02\u0E49\u0E2D\u0E21\u0E39\u0E25\u0E22\u0E32\u0E2A\u0E33\u0E2B\u0E23\u0E31\u0E1A\u0E15\u0E39\u0E49 SEMED</td>
                    </tr>
                  </tbody>
                </table>
              </div>
              <div class="action-footer" *ngIf="activeItem.status === 'FAILED' || activeItem.status === 'STOCK_LOW'" style="border-radius: 0 0 12px 12px;">
                 <button class="btn-dispense" (click)="retryItem(activeItem)">\u0E25\u0E2D\u0E07\u0E2D\u0E35\u0E01\u0E04\u0E23\u0E31\u0E49\u0E07 (Retry)</button>
              </div>
            </ng-container>
            <ng-template #loadingDrugs>
               <div style="padding: 40px; text-align: center; color: #94a3b8;">\u0E01\u0E33\u0E25\u0E31\u0E07\u0E42\u0E2B\u0E25\u0E14\u0E02\u0E49\u0E2D\u0E21\u0E39\u0E25\u0E22\u0E32...</div>
            </ng-template>
          </div>
        </div>
      </ng-container>
    </div>

    <ng-template #noActiveTpl>
      <div class="active-basket-container" style="border-color: #cbd5e1; background: #f8fafc; border-style: dashed; align-items: center; justify-content: center; text-align: center; padding: 60px;">
        <div style="grid-column: 1 / -1;">
          <h2 style="color: #94a3b8; font-weight: 500; font-size: 1.5rem; margin: 0;">\u0E23\u0E2D\u0E2A\u0E41\u0E01\u0E19\u0E15\u0E30\u0E01\u0E23\u0E49\u0E32\u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E40\u0E23\u0E34\u0E48\u0E21\u0E04\u0E34\u0E27\u0E08\u0E48\u0E32\u0E22\u0E22\u0E32...</h2>
        </div>
      </div>
    </ng-template>

    <!-- Upcoming Queue Section -->
    <div class="queue-section">
      <h3>
        <span>\u0E04\u0E34\u0E27\u0E23\u0E2D\u0E2A\u0E48\u0E07\u0E08\u0E48\u0E32\u0E22</span> 
        <span *ngIf="scannedItems.length > 1" style="background: #e2e8f0; color: #475569; padding: 2px 8px; border-radius: 12px; font-size: 0.9rem;">{{ scannedItems.length - 1 }} \u0E04\u0E34\u0E27</span>
      </h3>
      
      <div class="queue-list" *ngIf="scannedItems.length > 1; else noQueue">
        <div class="queue-card" *ngFor="let qItem of scannedItems | slice:1; let qIdx = index">
          <div class="q-header">
             <div class="q-num">{{ qIdx + 1 }}</div>
             <div class="q-basket">\u0E15\u0E30\u0E01\u0E23\u0E49\u0E32 {{ qItem.patientInfo?.basketno || '-' }}</div>
          </div>
          <div class="q-name">{{ qItem.patientInfo?.patientname || '\u0E44\u0E21\u0E48\u0E23\u0E30\u0E1A\u0E38\u0E0A\u0E37\u0E48\u0E2D' }}</div>
          <div class="q-status">
             <div class="dot-pulse"></div> \u0E23\u0E2D\u0E04\u0E34\u0E27...
          </div>
        </div>
      </div>
      
      <ng-template #noQueue>
         <div style="padding: 16px; background: #f8fafc; border: 1px dashed #cbd5e1; border-radius: 10px; color: #94a3b8; font-size: 0.9rem;">
            \u0E22\u0E31\u0E07\u0E44\u0E21\u0E48\u0E21\u0E35\u0E15\u0E30\u0E01\u0E23\u0E49\u0E32\u0E23\u0E2D\u0E04\u0E34\u0E27 (\u0E2A\u0E32\u0E21\u0E32\u0E23\u0E16\u0E2A\u0E41\u0E01\u0E19\u0E15\u0E30\u0E01\u0E23\u0E49\u0E32\u0E43\u0E1A\u0E15\u0E48\u0E2D\u0E44\u0E1B\u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E40\u0E02\u0E49\u0E32\u0E04\u0E34\u0E27\u0E44\u0E14\u0E49\u0E17\u0E31\u0E19\u0E17\u0E35)
         </div>
      </ng-template>
    </div>
  </main>

  <!-- History Queue Bar (Horizontal) -->
  <div class="history-bar" *ngIf="completedItems.length > 0">
    <h3>\u0E1B\u0E23\u0E30\u0E27\u0E31\u0E15\u0E34\u0E01\u0E32\u0E23\u0E2A\u0E48\u0E07\u0E02\u0E49\u0E2D\u0E21\u0E39\u0E25\u0E25\u0E48\u0E32\u0E2A\u0E38\u0E14:</h3>
    <div class="history-list">
      <div class="history-chip" *ngFor="let item of completedItems | slice:0:5">
        <span class="status-dot success"></span>
        \u0E15\u0E30\u0E01\u0E23\u0E49\u0E32 {{ item.patientInfo?.basketno || '-' }} ({{ item.patientInfo?.patientname || item.id }})
      </div>
    </div>
  </div>
</div>

<!-- Custom Modal -->
<div class="modal-overlay" *ngIf="showModal">
  <div class="custom-modal" [class.modal-error]="modalType === 'ERROR'" [class.modal-warning]="modalType === 'STOCK_LOW' || modalType === 'CONFIRM_REDO'">
    <div class="modal-header">
      <div class="modal-icon">
        {{ modalType === 'CONFIRM_REDO' ? '\u{1F504}' : (modalType === 'STOCK_LOW' ? '\u26A0\uFE0F' : '\u274C') }}
      </div>
      <h2>{{ modalTitle }}</h2>
    </div>
    <div class="modal-body">
      <p style="white-space: pre-wrap;">{{ modalMessage }}</p>
    </div>
    <div class="modal-footer">
      <button class="btn btn-secondary" *ngIf="modalType !== 'ERROR'" (click)="closeModal()">\u0E22\u0E01\u0E40\u0E25\u0E34\u0E01</button>
      <button class="btn btn-primary" (click)="confirmModal()">
        {{ modalType === 'CONFIRM_REDO' ? '\u0E2A\u0E31\u0E48\u0E07\u0E08\u0E31\u0E14\u0E22\u0E32\u0E0B\u0E49\u0E33' : (modalType === 'STOCK_LOW' ? '\u0E08\u0E48\u0E32\u0E22\u0E40\u0E17\u0E48\u0E32\u0E17\u0E35\u0E48\u0E21\u0E35' : '\u0E15\u0E01\u0E25\u0E07') }}
      </button>
    </div>
  </div>
</div>

<!-- Toast Notification -->
<div class="toast-container" [class.show]="toastMessage">
  <div class="toast-content">
    <span class="icon">\u2705</span>
    <span class="message">{{ toastMessage }}</span>
  </div>
</div>
`, styles: ['/* src/app/app.component.css */\n.app-container {\n  display: flex;\n  flex-direction: column;\n  height: 100vh;\n  background-color: var(--bg-color);\n  color: var(--text-main);\n  overflow: hidden;\n}\n.glass-panel {\n  background: var(--bg-panel);\n  border: 1px solid var(--border-color);\n  border-radius: 12px;\n  box-shadow: var(--shadow-md);\n}\n.topbar {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 12px 24px;\n  background: #ffffff;\n  border-bottom: 1px solid var(--border-color);\n  box-shadow: var(--shadow-sm);\n  z-index: 10;\n}\n.logo {\n  display: flex;\n  align-items: center;\n  gap: 15px;\n}\n.hospital-logos {\n  display: flex;\n  align-items: center;\n  gap: 15px;\n  padding-right: 15px;\n  border-right: 2px solid var(--border-color);\n}\n.logo-img {\n  height: 40px;\n  object-fit: contain;\n}\n.logo h1 {\n  margin: 0;\n  font-size: 1.3rem;\n  font-weight: 600;\n  color: var(--primary-dark);\n  letter-spacing: 0.5px;\n}\n.version {\n  font-size: 0.75rem;\n  color: var(--text-muted);\n  background: var(--bg-panel-muted);\n  padding: 3px 8px;\n  border-radius: 12px;\n  border: 1px solid var(--border-color);\n  font-weight: 500;\n}\n.status-indicators {\n  display: flex;\n  gap: 16px;\n}\n.indicator {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  font-size: 0.85rem;\n  color: var(--text-muted);\n  font-weight: 500;\n}\n.indicator.active {\n  color: var(--primary-dark);\n}\n.indicator.active .dot {\n  background: var(--success-color);\n  box-shadow: 0 0 6px rgba(16, 185, 129, 0.5);\n}\n.dot {\n  width: 8px;\n  height: 8px;\n  border-radius: 50%;\n  background: #cbd5e1;\n}\n.main-layout-container {\n  width: 100%;\n  box-sizing: border-box;\n  margin: 0 auto;\n  flex: 1;\n  padding: 24px 40px 40px 40px;\n}\n.active-basket-container {\n  display: grid;\n  grid-template-columns: 320px 1fr;\n  gap: 24px;\n  background: var(--bg-panel);\n  border: 2px solid var(--primary-color);\n  border-radius: 12px;\n  box-shadow: 0 8px 30px rgba(13, 148, 136, 0.15);\n  padding: 24px;\n  position: relative;\n  overflow: hidden;\n  transition: all 0.3s;\n}\n.active-basket-container::before {\n  content: "";\n  position: absolute;\n  top: 0;\n  left: 0;\n  right: 0;\n  height: 4px;\n  background:\n    linear-gradient(\n      90deg,\n      var(--primary-color),\n      #34d399);\n}\n.glass-panel.auto-height {\n  height: auto;\n  min-height: 200px;\n}\n.main-layout {\n  display: flex;\n  flex: 1;\n  gap: 20px;\n  padding: 20px;\n  overflow: hidden;\n}\n.active-panel {\n  flex: 0 0 35%;\n  display: flex;\n  flex-direction: column;\n}\n.drugs-panel {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n}\n.panel-title {\n  font-size: 1.1rem;\n  font-weight: 600;\n  color: var(--primary-dark);\n  margin: 0 0 12px 4px;\n}\n.active-card {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n}\n.patient-details {\n  padding: 24px;\n  height: 100%;\n  display: flex;\n  flex-direction: column;\n  justify-content: center;\n}\n.patient-header {\n  display: flex;\n  align-items: center;\n  gap: 20px;\n  margin-bottom: 30px;\n}\n.avatar {\n  width: 80px;\n  height: 80px;\n  border-radius: 50%;\n  background: var(--bg-panel-muted);\n  border: 2px solid var(--primary-color);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 2.5rem;\n  font-weight: 600;\n  color: var(--primary-dark);\n}\n.patient-header-clean {\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n  margin-bottom: 24px;\n}\n.patient-header-clean h3 {\n  margin: 0;\n  font-size: 1.8rem;\n  font-weight: 600;\n  color: var(--primary-dark);\n}\n.name-block h3 {\n  margin: 0 0 12px 0;\n  font-size: 1.8rem;\n  font-weight: 500;\n  color: var(--text-main);\n}\n.badge {\n  display: inline-block;\n  padding: 6px 12px;\n  border-radius: 6px;\n  font-size: 1rem;\n  font-weight: 600;\n  margin-right: 10px;\n}\n.vn-badge {\n  background: #e0f2fe;\n  color: #0369a1;\n  border: 1px sol