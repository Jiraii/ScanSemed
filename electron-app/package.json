{
    "version": "1.0.0",
    "name": "scan",
    "description": "",
    "scripts": {
        "build:angular": "powershell -Command \"cd ../web-frontend-source; npm run build; if ($LASTEXITCODE -eq 0) { Copy-Item -Path './dist/web-frontend-source/browser/*' -Destination '../electron-app/dist/web-frontend/browser' -Recurse -Force }\"",
        "pack": "electron-builder --dir",
        "dist": "npm run build:angular && electron-builder",
        "start": "electron ."
    },
    "build": {
        "appId": "com.hospital.scan",
        "productName": "Scan",
        "directories": {
            "output": "D:/Scan"
        },
        "extraFiles": [
            {
                "filter": [
                    "**/*"
                ],
                "from": "../SoapWorker",
                "to": "SoapWorker"
            }
        ],
        "win": {
            "target": [
                "nsis",
                "portable"
            ],
            "icon": "icon.png"
        }
    },
    "main": "main.js",
    "dependencies": {
        "@serialport/parser-readline": "^13.0.0",
        "axios": "^1.20.0",
        "cors": "^2.8.6",
        "electron": "^44.1.0",
        "express": "^5.2.1",
        "mssql": "^12.7.0",
        "mysql2": "^3.24.2",
        "serialport": "^13.0.0",
        "ws": "^8.21.3"
    },
    "devDependencies": {
        "electron-builder": "^26.15.3"
    }
}
