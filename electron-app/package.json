{
    "version":  "1.0.0",
    "name":  "scan",
    "description":  "BDSender SEMED",
    "main":  "main.js",
    "dependencies":  {
                         "@serialport/parser-readline":  "^13.0.0",
                         "axios":  "^1.20.0",
                         "cors":  "^2.8.6",
                         "express":  "^5.2.1",
                         "mssql":  "^12.7.0",
                         "mysql2":  "^3.24.2",
                         "serialport":  "^13.0.0",
                         "ws":  "^8.21.3"
                     },
    "author":  "Jiraii",
    "devDependencies":  {
                            "electron":  "^28.0.0",
                            "electron-builder":  "^24.9.1"
                        },
    "scripts":  {
                    "build:win":  "electron-builder --win --x64",
                    "postinstall":  "electron-builder install-app-deps",
                    "start":  "electron ."
                },
    "build":  {
                  "appId":  "com.nakornping.bdsender",
                  "productName":  "BDSender SEMED",
                  "nsis":  {
                               "oneClick":  true,
                               "perMachine":  true,
                               "runAfterFinish":  true,
                               "allowToChangeInstallationDirectory":  false,
                               "createDesktopShortcut":  true,
                               "createStartMenuShortcut":  true,
                               "shortcutName":  "BDSender SEMED"
                           },
                  "win":  {
                              "target":  "nsis"
                          },
                  "directories":  {
                                      "output":  "D:\\Scan"
                                  }
              }
}
